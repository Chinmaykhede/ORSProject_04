<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Footer</title>

<link rel="stylesheet"
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">

<style type="text/css">
#footer {
	position: fixed;
	left: 0;
	bottom: 0;
	width: 100%;
	background-color: #f8f9fa;
	color: #212529;
	text-align: center;
	padding: 12px 15px;
	border-top: 3px solid #0d6efd;
	box-sizing: border-box;
}

#footer h3 {
	font-size: clamp(14px, 2.5vw, 20px);
	font-weight: 500;
	margin: 0;
	line-height: 1.6;
	overflow-wrap: break-word;
}

#footer hr {
	display: none;
}
</style>

</head>
<body>

	<footer id="footer" class="container-fluid">
		<div class="container">
			<h3>
				All rights reserved by Rays EdTech, SunilOS Infotech Pvt Ltd
				Copyright &copy; 2026
			</h3>
		</div>
	</footer>

</body>
</html>
